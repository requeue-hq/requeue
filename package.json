{
  "name": "requeue",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source dead-letter inbox for webhooks, crons, and workers — catch failures, one-click replay",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create": "wrangler d1 create requeue",
    "db:migrate": "wrangler d1 migrations apply requeue --local && wrangler d1 execute requeue --local --file=scripts/seed-local.sql",
    "db:seed:local": "wrangler d1 execute requeue --local --file=scripts/seed-local.sql",
    "db:migrate:remote": "wrangler d1 migrations apply requeue --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "4.13.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.4",
    "@cloudflare/workers-types": "5.20260904.1",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/requeue-hq/requeue.git"
  }
}
